{
  "name": "gearsdigital/we-are-open",
  "description": "Kirby plugin for managing store opening hours",
  "type": "kirby-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "getkirby/cms": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "GearsDigital\\WeAreOpen\\": "lib/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/KirbyTestCase.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
